{
  "name": "@meteo-consensus/contracts",
  "version": "0.0.0",
  "description": "Contrat public : OpenAPI, schémas Zod et types partagés (modèles, variables, unités, consensus). Paquet @meteo-consensus/contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run audit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit": "pnpm audit --audit-level high",
    "unused": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.44.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
