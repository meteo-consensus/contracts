{
  "name": "@meteo-consensus/contracts",
  "version": "0.0.0",
  "description": "Contrat public : OpenAPI, schémas Zod et types partagés (modèles, variables, unités, consensus). Paquet @meteo-consensus/contracts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run audit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit": "pnpm audit --audit-level high",
    "unused": "knip --tsConfig tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.44.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
